use ingot::game::Game

const TURN_BIT: u256 = 1 << 12

pub struct Nim {}
pub struct NimState(pub u256)
impl Copy for NimState {}

fn heap(_ word: u256, _ index: u8) -> u8 {
    ((word >> (index as u256 * 4)) & 15).downcast_unchecked()
}

pub fn xor_value(_ state: NimState) -> u8 {
    heap(state.0, 0) ^ heap(state.0, 1) ^ heap(state.0, 2)
}

impl Game for Nim {
    type State = NimState
    fn initial() -> Self::State {
        NimState(1 | (3 << 4) | (5 << 8))
    }
    fn encode(_ state: Self::State) -> u256 {
        state.0
    }
    fn decode(_ word: u256) -> Self::State {
        NimState(word)
    }
    fn turn(_ state: Self::State) -> u8 {
        if state.0 & TURN_BIT == 0 { 1 } else { 2 }
    }
    fn move_space() -> u8 {
        24
    }
    fn legal(_ state: Self::State, _ mv: u8) -> bool {
        if mv >= 24 || Self::winner(state) != 0 {
            return false
        }
        let h = mv / 8
        let take = mv % 8 + 1
        h < 3 && heap(state.0, h) >= take
    }
    fn apply(_ state: Self::State, _ mv: u8) -> Self::State {
        assert!(Self::legal(state, mv), "illegal nim move")
        let h = mv / 8
        let take = mv % 8 + 1
        let shift = h as u256 * 4
        let cleared = state.0 & !(15 << shift)
        let next = heap(state.0, h) - take
        NimState((cleared | ((next as u256) << shift)) ^ TURN_BIT)
    }
    fn winner(_ state: Self::State) -> u8 {
        if heap(state.0, 0) != 0 || heap(state.0, 1) != 0 || heap(state.0, 2) != 0 {
            return 0
        }
        if Self::turn(state) == 1 { 2 } else { 1 }
    }
}
