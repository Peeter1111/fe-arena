use ingot::game::Game
use std::evm::StorageMap

pub struct MatchState {
    pub state: u256,
    pub p1: Address,
    pub p2: Address,
    pub deadline: Timestamp,
    pub forced_winner: u8,
    pub active: bool,
}
impl Copy for MatchState {}

pub struct MatchBook {
    pub next_id: u256,
    pub timeout: Duration,
    pub matches: StorageMap<u256, MatchState>,
}

impl MatchBook {
    pub fn init(mut self, _ timeout: Duration) {
        self.next_id = 1
        self.timeout = timeout
    }

    pub fn create<G: Game>(mut self, _ p1: Address, _ p2: Address, _ now: Timestamp) -> u256 {
        assert!(p2 != Address::zero() && p1 != p2, "invalid opponent")
        let id = self.next_id
        self.next_id += 1
        self.matches
            .set(
                key: id,
                value: MatchState {
                    state: G::encode(state: G::initial()),
                    p1: p1,
                    p2: p2,
                    deadline: now + self.timeout,
                    forced_winner: 0,
                    active: true,
                },
            )
        id
    }

    pub fn get(self, _ id: u256) -> MatchState {
        let item = self.matches.get(key: id)
        assert!(item.active, "unknown match")
        item
    }

    pub fn winner<G: Game>(self, _ id: u256) -> u8 {
        let item = self.get(id)
        if item.forced_winner != 0 {
            item.forced_winner
        } else {
            G::winner(state: G::decode(item.state))
        }
    }

    pub fn play<G: Game>(
        mut self,
        _ id: u256,
        _ move_code: u8,
        _ caller: Address,
        _ now: Timestamp,
    ) -> u8 {
        var item = self.get(id)
        assert!(self.winner<G>(id) == 0, "match finished")
        assert!(now < item.deadline, "turn expired")
        let state = G::decode(item.state)
        let expected = if G::turn(state) == 1 {
            item.p1
        } else {
            item.p2
        }
        assert!(caller == expected, "not your turn")
        assert!(G::legal(state, move_code), "illegal move")
        let next = G::apply(state, move_code)
        item.state = G::encode(state: next)
        item.deadline = now + self.timeout
        self.matches.set(key: id, value: item)
        G::winner(next)
    }

    pub fn claim_timeout<G: Game>(mut self, _ id: u256, _ caller: Address, _ now: Timestamp) -> u8 {
        var item = self.get(id)
        assert!(self.winner<G>(id) == 0, "match finished")
        assert!(now >= item.deadline, "turn window open")
        let turn = G::turn(state: G::decode(item.state))
        let waiting = if turn == 1 { item.p2 } else { item.p1 }
        assert!(caller == waiting, "only waiting player")
        item.forced_winner = if turn == 1 { 2 } else { 1 }
        self.matches.set(key: id, value: item)
        item.forced_winner
    }
}
