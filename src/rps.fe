use ingot::hidden_game::HiddenGame

pub struct RpsThree {}
pub struct RpsState(pub u256)
impl Copy for RpsState {}

// Bits: player-one wins [0..1], player-two wins [2..3], rounds [4..5].
impl HiddenGame for RpsThree {
    type State = RpsState
    fn initial() -> Self::State {
        RpsState(0)
    }
    fn encode(_ state: Self::State) -> u256 {
        state.0
    }
    fn decode(_ word: u256) -> Self::State {
        RpsState(word)
    }
    fn legal(_ state: Self::State, _ mv: u8) -> bool {
        mv < 3 && Self::winner(state) == 0
    }
    fn resolve(_ state: Self::State, _ p1: u8, _ p2: u8) -> Self::State {
        assert!(
            Self::legal(state, p1) && Self::legal(state, p2),
            "illegal round",
        )
        let point: u256 = if p1 == p2 {
            0
        } else if (p1 + 1) % 3 == p2 { 4 } else { 1 }
        RpsState(state.0 + (1 << 4) + point)
    }
    fn winner(_ state: Self::State) -> u8 {
        let a = state.0 & 3
        let b = (state.0 >> 2) & 3
        if a >= 2 { return 1 }
        if b >= 2 { return 2 }
        if (state.0 >> 4) >= 3 {
            if a > b { 1 } else if b > a { 2 } else { 3 }
        } else {
            0
        }
    }
}
