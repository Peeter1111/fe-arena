use ingot::game::Game

const TURN_BIT: u256 = 1 << 32

pub struct MiniConnect4 {}
pub struct Connect4State(pub u256)
impl Copy for Connect4State {}

fn cell(_ word: u256, _ row: u8, _ col: u8) -> u8 {
    let pos = row as u256 * 4 + col as u256
    ((word >> (pos * 2)) & 3).downcast_unchecked()
}

fn four(_ word: u256, _ a: (u8, u8), _ b: (u8, u8), _ c: (u8, u8), _ d: (u8, u8)) -> u8 {
    let mark = cell(word, a.0, a.1)
    if mark != 0
        && mark == cell(word, b.0, b.1)
        && mark == cell(word, c.0, c.1)
        && mark == cell(word, d.0, d.1) {
        mark
    } else {
        0
    }
}

impl Game for MiniConnect4 {
    type State = Connect4State
    fn initial() -> Self::State {
        Connect4State(0)
    }
    fn encode(_ state: Self::State) -> u256 {
        state.0
    }
    fn decode(_ word: u256) -> Self::State {
        Connect4State(word)
    }
    fn turn(_ state: Self::State) -> u8 {
        if state.0 & TURN_BIT == 0 { 1 } else { 2 }
    }
    fn move_space() -> u8 {
        4
    }
    fn legal(_ state: Self::State, _ mv: u8) -> bool {
        mv < 4 && Self::winner(state) == 0 && cell(state.0, 3, mv) == 0
    }
    fn apply(_ state: Self::State, _ mv: u8) -> Self::State {
        assert!(Self::legal(state, mv), "illegal connect-four move")
        var row: u8 = 0
        while cell(state.0, row, mv) != 0 {
            row += 1
        }
        let pos = row as u256 * 4 + mv as u256
        let word = state.0 | ((Self::turn(state) as u256) << (pos * 2))
        Connect4State(word ^ TURN_BIT)
    }
    fn winner(_ state: Self::State) -> u8 {
        var i: u8 = 0
        while i < 4 {
            let row = four(state.0, (i, 0), (i, 1), (i, 2), (i, 3))
            if row != 0 { return row }
            let col = four(state.0, (0, i), (1, i), (2, i), (3, i))
            if col != 0 { return col }
            i += 1
        }
        let down = four(state.0, (0, 0), (1, 1), (2, 2), (3, 3))
        if down != 0 { return down }
        let up = four(state.0, (0, 3), (1, 2), (2, 1), (3, 0))
        if up != 0 { return up }
        if cell(state.0, 3, 0) != 0
            && cell(state.0, 3, 1) != 0
            && cell(state.0, 3, 2) != 0
            && cell(state.0, 3, 3) != 0 {
            3
        } else {
            0
        }
    }
}
