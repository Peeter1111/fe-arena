    mut book: MatchBook,
    init(timeout: Duration) uses (mut book) { book.init(timeout) }
    recv ArenaMsg {
        Create { opponent } -> u256 uses (ctx, mut book) {
            book.create<Nim>(ctx.caller(), opponent)
        }
        Commit { id, hash } uses (ctx, mut book) {
            book.commit<Nim>(id, hash, ctx.caller(), ctx.timestamp())
        }
        Reveal { id, move_code, secret } -> u8 uses (ctx, mut book) {
            book.reveal<Nim>(id, move_code, secret, ctx.caller())
        }
        ClaimTimeout { id } -> u8 uses (ctx, mut book) {
            book.claim_timeout<Nim>(id, ctx.timestamp())
        }
        State { id } -> (u256, u8) uses (book) {
            (book.get(id).state, book.winner<Nim>(id))
        }
    }
}
